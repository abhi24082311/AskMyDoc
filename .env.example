# Application Settings
APP_NAME="Ask My Docs RAG"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Storage Paths
DOCS_DIR=data/docs
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=ask_my_docs
BM25_INDEX_DIR=data/bm25_index

# Chunking & Embeddings
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=90
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Retrieval
TOP_K=4
RETRIEVAL_MODE=vector_only
RETRIEVAL_CANDIDATE_K=20
RRF_K=60
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
QUERY_CACHE_SIZE=128
QUERY_CACHE_TTL_SECONDS=300.0

# Evaluation
EVAL_GOLDEN_PATH=eval/golden.jsonl
EVAL_RESULTS_DIR=eval
EVAL_CANDIDATE_COUNT=50
EVAL_OLLAMA_MODEL=llama3.2
EVAL_LLM_TIMEOUT_SECONDS=180
EVAL_MAX_TOKENS=1024
EVAL_MIN_FAITHFULNESS=0.30
EVAL_MIN_ANSWER_RELEVANCY=0.30
EVAL_MIN_CONTEXT_PRECISION=0.30
EVAL_MIN_CONTEXT_RECALL=0.30
EVAL_MIN_RECALL_AT_K=0.50
EVAL_MIN_MRR=0.50

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60.0
